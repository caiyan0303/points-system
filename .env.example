# Local FastAPI: use the Supabase Session pooler (port 5432).
# Netlify Functions: use the Supabase Transaction pooler (port 6543).
# Never commit the real password or connection string.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Use a long random value in production.
JWT_SECRET=replace-with-a-long-random-secret
